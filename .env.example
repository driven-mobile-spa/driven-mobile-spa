# Driven Mobilespa – site configuration
# Copy to `.env.local` for local dev, or set as Repository Secrets/Variables
# on GitHub for the Actions build. All VITE_* vars are bundled into the
# static site at build time.

# --- Business identity ---
VITE_BUSINESS_NAME="Driven Mobilespa"
VITE_BUSINESS_PHONE="+27 82 000 0000"
VITE_WHATSAPP_NUMBER="27820000000"          # international, no leading +
VITE_BUSINESS_EMAIL="bookings@driven-mobilespa.com"
VITE_BUSINESS_ADDRESS="Melkbosstrand, Cape Town, 7441"

# --- Google Business Profile ---
# From your Google Business Profile → Reviews → "Share review link"
VITE_GOOGLE_REVIEWS_URL="https://g.page/r/YOUR_ID"
VITE_GOOGLE_WRITE_REVIEW_URL="https://g.page/r/YOUR_ID/review"

# --- Google Maps embed ---
# Google Maps → Share → Embed a map → copy value of src="..."
VITE_GOOGLE_MAPS_EMBED_SRC="https://www.google.com/maps/embed?pb=..."

# --- Socials (optional) ---
VITE_INSTAGRAM_URL="https://instagram.com/drivenmobilespa"
VITE_FACEBOOK_URL="https://facebook.com/drivenmobilespa"

# --- Google Forms booking bridge ---
# Open your form → View page source → search "formResponse"
VITE_GOOGLE_FORM_ACTION="https://docs.google.com/forms/d/e/FORM_ID/formResponse"
# For each field, find its `name="entry.NNNN"` in the form source
VITE_GF_FIELD_NAME="entry.0000000000"
VITE_GF_FIELD_PHONE="entry.0000000000"
VITE_GF_FIELD_EMAIL="entry.0000000000"
VITE_GF_FIELD_VEHICLE="entry.0000000000"
VITE_GF_FIELD_SIZE="entry.0000000000"
VITE_GF_FIELD_SERVICE="entry.0000000000"
VITE_GF_FIELD_DATE="entry.0000000000"
VITE_GF_FIELD_LOCATION="entry.0000000000"
VITE_GF_FIELD_NOTES="entry.0000000000"
